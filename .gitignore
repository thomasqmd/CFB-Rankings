# History & Environment
.Rhistory
.RData
.Ruserdata
.Renviron
.env*
.Rproj.user/

# Targets workflow store
_targets/
_targets_r/
*.qs

# DuckDB database and write-ahead logs
data/*.duckdb
data/*.duckdb.wal
data/*.tmp
data/inits/

# Compiled binaries and Stan models
*.o
*.so
*.rds
stan/*.exe
stan/*_model
stan/*.hpp

# Quarto & Knitr cache and freeze directory. Rendered HTML and PDF are
# tracked so they can be hosted from any machine.
.quarto/
_freeze/
*_cache/
*_files/
*.docx
*.pptx

# Supporting files for the non-self-contained HTML reports
!docs/**/*_files/

# OS artifacts
.DS_Store
Thumbs.db
.agents

/.quarto/
**/*.quarto_ipynb

# Raw CFBD API responses (re-creatable, but cached to save API calls)
data/raw/
# Compiled Stan executables (no extension on Linux)
stan/*
!stan/*.stan
